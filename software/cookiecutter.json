{
  "project_name": "My Project",
  "project_slug": "{{ cookiecutter.project_name.lower().replace(' ', '-') }}",
  "repo_base": "{{ cookiecutter.project_slug }}",
  "repo_name": "{{ cookiecutter.repo_base }}",
  "description": "A web application.",
  "author_name": "Your Name",
  "github_owner": "your-github-user",
  "license": ["Apache-2.0", "MIT", "none"],
  "python_version": "3.14",
  "backend_django": ["yes", "no"],
  "frontend_nextjs": ["yes", "no"],
  "proxy_caddy": ["yes", "no"],
  "gateway_litellm": ["no", "yes"],
  "ml_pytorch": ["no", "yes"],
  "db_port": "5440",
  "_python_floor": "3.12",
  "_template_kind": "software",
  "_copy_without_render": [
    "gateway/policy.py",
    "frontend/.dockerignore",
    "frontend/Dockerfile",
    "frontend/components",
    "frontend/config",
    "frontend/eslint.config.mjs",
    "frontend/features",
    "frontend/hooks",
    "frontend/lib",
    "frontend/next.config.ts",
    "frontend/pnpm-workspace.yaml",
    "frontend/scripts",
    "frontend/styles",
    "frontend/tests",
    "frontend/tsconfig.json",
    "frontend/types",
    "frontend/vitest.config.ts",
    "frontend/app/(main)/loading.tsx",
    "frontend/app/error.tsx",
    "frontend/app/global-error.tsx",
    "frontend/app/not-found.tsx"
  ],
  "__prompts__": {
    "project_name": "Project name, as people write it",
    "project_slug": "Project slug (the board label and session names use it)",
    "repo_base": "Repository base name (may differ from the slug)",
    "license": "Licence",
    "backend_django": "Include the Django and DRF backend, with Postgres?",
    "db_port": "Host port for the development Postgres (pick one no other project uses)",
    "frontend_nextjs": "Include the Next.js frontend? (it needs the backend)",
    "ml_pytorch": "Serve a PyTorch model from the backend? (CPU wheels on Linux)"
  }
}
