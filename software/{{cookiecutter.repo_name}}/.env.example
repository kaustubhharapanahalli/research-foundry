# Every setting the project reads from its environment, with what it does.
# Copy to .env for local overrides; .env is never committed. Each value has
# a development default, so .env is optional on a laptop. Production sets
# them in its own environment, and prod.py refuses to start without the
# required ones.

# --- Postgres -------------------------------------------------------------
# POSTGRES_HOST=localhost             # "db" inside compose
# POSTGRES_PORT={{ cookiecutter.db_port }}                  # the host port compose publishes
# POSTGRES_DB=app
# POSTGRES_USER=app
# POSTGRES_PASSWORD=dev-only-password # required in production

# --- Django ---------------------------------------------------------------
# DJANGO_SECRET_KEY=                  # required in production
# DJANGO_SECRET_KEY_FALLBACKS=        # old keys, comma-separated, to rotate
# DJANGO_ALLOWED_HOSTS=               # required in production, comma-separated
# DJANGO_CSRF_TRUSTED_ORIGINS=        # required in production, comma-separated
# DJANGO_DEBUG=                       # any value makes prod.py refuse to start
# DJANGO_NUM_PROXIES=0                # proxies in front, for DRF's client IP
# DJANGO_TRUST_FORWARDED_PROTO=       # 1 only behind a proxy that replaces
#                                     # the client's X-Forwarded-Proto
{%- if cookiecutter.frontend_nextjs == "yes" %}

# --- Frontend -------------------------------------------------------------
# BACKEND_URL=http://127.0.0.1:8000   # read by the Next server per request;
#                                     # compose sets http://backend:8000
{%- endif %}
{%- if cookiecutter.proxy_caddy == "yes" %}

# --- Proxy ----------------------------------------------------------------
# SITE_ADDRESS=localhost              # the public domain on a server
# PROXY_PORT=8443                     # the laptop's loopback HTTPS port
{%- endif %}
{%- if cookiecutter.gateway_litellm == "yes" %}

# --- Gateway --------------------------------------------------------------
# LITELLM_MASTER_KEY=                 # required; must start with sk-
# GATEWAY_CONFIG=config.yaml          # a file in gateway/; tests use another
{%- endif %}
{%- if cookiecutter.ml_pytorch == "yes" %}

# --- Model ----------------------------------------------------------------
# ML_WEIGHTS=                         # the state_dict file; without it, 503
# ML_DEVICE=cpu                       # cpu, cuda or mps; never a fallback
# ML_THREADS=1                        # PyTorch threads per web worker
{%- endif %}
