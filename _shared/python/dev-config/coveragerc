[run]
branch = True
{%- if cookiecutter.get("backend_django") == "yes" %}
source = backend
# Migrations are generated by makemigrations, and the drift test checks
# what they create; tests are not the code under test.
omit =
    */migrations/*
    */tests/*
    backend/conftest.py
{%- else %}
source = {{ cookiecutter.package_name }}
{%- endif %}

[report]
fail_under = 90
show_missing = True
skip_covered = True
